    n "Леон открывает один из ящиков и находит личные карты учеников..."

    if in_party('helena'):
        h "Так-так-так..."
        h "Целая кипа материала..."
        h "То, что нужно!"
        l "Нет, Хелена!"
        l "Мы здесь не за этим!"

    l "А это что на шкафу?"
