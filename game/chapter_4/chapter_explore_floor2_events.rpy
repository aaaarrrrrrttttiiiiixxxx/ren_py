label exp2_history:
    scene bg history
    with dissolve

    n "Леон отворяет дверь в кабинет истории..."
    n "С верхней полки из переполненного шкафа на него летит тяжелый учебник истории..."

    call parry(items=[("Поймать учебник", "catch"), ("Уклониться", "dodge")], prompt="Летящий учебник истории!")

    if _return == "__miss__":
        $ leon_take_wound()
        n "Учебник ударяет Леона по голове..."
        n "Леон получает ранение..."
        l "Ауч! Похоже, останется шишка..."
    else:
        n "Леон успевает заметить учебник и ловит его одной рукой..."
        l "[[Может я человек паук?]"

    if in_party('helena'):
        h "[[А такой шанс был...]"
        h "[[Как я не успела это заснять...]"

    l "Да..."
    l "Историю люблю всей душой..."

    n "Леон оглядывает кабинет..."

    l "Это что..."
    l "Самурайский меч?.."
    l "Ах да..."
    l "Бутафорский..."

    if in_party('helena'):
        h "Может и бутафорский..."
        h "Но Незу-кун и им умудрился порезаться..."

    l "Ну так или иначе..."
    l "Думаю, лишним не будет..."

    n "Леон показательно делает несколько ударов по воздуху..."
    n "И убирает меч в ножны..."

    if not _e_history:
        n "Сила Леона увеличена на 1."
        $ stat_add('leon', 'strength', 1)
        $ _e_history = True

    return
