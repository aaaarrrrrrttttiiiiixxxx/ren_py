        "Два лица в диалоге":
            n "Социальная, эмоциональная трактовка..."
            $ stat_add('leon', 'empathy', 1)

        "Разлом кубической структуры":
            n "Аналитический взгляд..."
            $ stat_add('leon', 'intellect', 1)

        "Силуэт в боевой стойке":
            n "Напряженное, деятельное восприятие..."
            $ stat_add('leon', 'strength', 1)

    $ _e_psychologist = True

    return

