        if in_party('helena'):
            h "Да ладно тебе, зануда..."
            h "Давай посмотрим!"

    n "Леон проходит дальше в кабинет обществознания..."

    l "Так это что?.."
    l "Кабинет обществознания?.."
    l "Все время удивляло, что для обществознания есть специализированный кабинет..."

    n "Кабинет довольно просторный, но особо ничем не выделяется..."
    n "Привычные парты, столы и стульи..."

    if in_party('helena'):
        h "Да уж..."
        h "Скукотища..."
        h "Самый скучный кабинет..."
        h "У меня даже нет ни одной связанной с ним истории..."
        h "Это полнейший провал..."

    l "В прошлую пятницу мы играли в суд..."
    l "Где-то за учительским столом должен быть молоток..."

    n "Леон шарится в ящиках и шкафчиках..."

    l "Отлично!"
    l "Судейский молоток!"
    l "Может и не самое лучшее оружие..."
    l "Но довольно легкое..."

    return

