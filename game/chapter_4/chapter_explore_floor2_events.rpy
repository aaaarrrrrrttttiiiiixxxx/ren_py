label exp2_men_toilet:
    scene bg men_toilet
    with dissolve

    if in_party('helena'):
        h "Ладно-ладно, я подожду..."
        h "Или можно..."

    l "Думаю, нужно умыться и прийти в себя..."

    n "Леон открывает кран и несколько раз брызгает себе на лицо..."

    l "[[Я...]"
    l "[[Справлюсь...]"
    l "[[Не каждый день приходится сталкиваться с таким...]"
    l "[[Ситуация мягко говоря патовая...]"
    l "[[Но я должен хотя бы попытаться...]"

    if not _e_men_toilet:
        python:
            _stats = char_stats['leon']
            _min_stat = STAT_ORDER[0]
            for _s in STAT_ORDER:
                if _stats[_s] < _stats[_min_stat]:
                    _min_stat = _s
            stat_add('leon', _min_stat, 1)
        n "Наименьшая характеристика Леона увеличивается на 1."
        $ _e_men_toilet = True

    return

label exp2_chemistry:
    scene bg chemistry
