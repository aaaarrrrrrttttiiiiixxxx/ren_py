init python:
    EMO_TO_KEY = {
        'нейтрально': 'neutral', 'нейтральная': 'neutral',
        'радостно': 'happy', 'радостная': 'happy', 'весело': 'happy', 'довольно': 'happy',
        'испуганно': 'worried', 'испуганная': 'worried',
        'встревоженно': 'worried', 'встревоженная': 'worried', 'тревожно': 'worried',
        'смущенно': 'worried', 'смущенная': 'worried',
        'сердито': 'angry', 'сердитая': 'angry',
        'возмущенно': 'angry', 'возмущенная': 'angry',
        'командуя': 'angry', 'злостно': 'angry', 'озадаченно': 'worried',
        'недовольно': 'angry', 'удивленно': 'worried',
        'уверенно': 'confident', 'уверенная': 'confident', 'одобрительно': 'confident',
        'грустно': 'sad', 'грустная': 'sad',
        'расстроенно': 'sad', 'растроенно': 'sad', 'расстроенная': 'sad', 'растроенная': 'sad',
        'smile': 'happy', 'closed_smile': 'happy', 'opensmile': 'happy',
        'frown': 'worried', 'closed_frown': 'worried',
        'open': 'angry', 'closed_open': 'angry', 'shout': 'angry', 'pout': 'angry',
        'happy': 'happy', 'worried': 'worried', 'angry': 'angry',
        'confident': 'confident', 'sad': 'sad', 'neutral': 'neutral',
    }

    GIRL_EMO_FALLBACK = {
        'alice':  {'sad': 'worried', 'confident': 'happy'},
        'mari':   {'angry': 'worried', 'confident': 'happy'},
        'shinna': {'happy': 'confident', 'sad': 'worried'},
        'helena': {},
        'sylvia': {},
    }

    def normalize_emo(girl, emo):
        if emo is None or emo == '':
            return 'neutral'
        e = emo.strip().lower()
        key = EMO_TO_KEY.get(e, e)
        avail = GIRL_EMO_FALLBACK.get(girl, {})
        if girl in ('alice', 'mari', 'shinna'):
            canonical = {
                'alice': ['neutral', 'happy', 'worried', 'angry'],
                'mari': ['neutral', 'happy', 'worried', 'sad'],
                'shinna': ['neutral', 'confident', 'worried', 'angry'],
            }[girl]
            if key not in canonical:
                key = avail.get(key, 'neutral')
        return key

    def girl_sprite_name(girl, emo='neutral'):
        key = normalize_emo(girl, emo)
        return girl + " " + key

    def c_show(emo='neutral'):
        if not companion:
            return
        renpy.show(girl_sprite_name(companion, emo))

    def show_girl(girl, emo='neutral', at=None):
        name = girl_sprite_name(girl, emo)
        if at is not None:
            renpy.show(name, [at])
        else:
            renpy.show(name)

    def show_companion_mask(mask_id):
        if not companion:
            return
        renpy.show(companion + " mask " + mask_id)
